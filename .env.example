# BY SARA GREENFIELD ONLY — lingering-sea-03313730 / bysara_v2
# Never paste production credentials in GitHub, chat, client bundles or screenshots.
# Explicit target binding: preview uses the isolated phase5-preview branch.
BY_SARA_TARGET=preview
# Preview DB endpoint: ep-silent-rice-b9eftr6y; main: ep-bitter-flower-b9z8sqci
DATABASE_URL=
NEON_AUTH_BASE_URL=https://ep-silent-rice-b9eftr6y.neonauth.c-7.eu-central-1.aws.neon.tech/bysara_v2/auth
# Generate locally (openssl rand -base64 48); 32+ characters; server side ONLY
NEON_AUTH_COOKIE_SECRET=
# Keep false until Email/Password login and email verification are manually tested.
NEXT_PUBLIC_ENABLE_CUSTOMER_AUTH=false
# Staff sign-in is a separate explicit flag; leave false until controlled Auth verification.
NEXT_PUBLIC_ENABLE_STAFF_LOGIN=false

# REQUIRED for production Admin POST/PATCH; exact HTTPS origin of your NEW Vercel project
# Do NOT use the previous project URL. Without this, admin mutations fail closed in production.
APP_ORIGIN=

# Phase 5 — Greenfield Neon branchable Object Storage, server-side ONLY.
# Create scoped credentials through Neon Console/CLI. Never use old BY SARA credentials.
# Preview credentials must belong to project lingering-sea-03313730, branch br-tiny-water-b9p2xphd.
# Production credentials (later) must belong to br-sweet-brook-b9pcekde.
NEON_STORAGE_BRANCH_ID=br-tiny-water-b9p2xphd
AWS_ENDPOINT_URL_S3=https://br-tiny-water-b9p2xphd.storage.c-7.eu-central-1.aws.neon.tech
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket by-sara-v2-product-media already exists (public_read, not public_write).
